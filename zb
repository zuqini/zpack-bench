#!/usr/bin/env python3
"""zb: zpack startup validation and benchmarks against lazy.nvim. `zb <command> -h` for details."""
import argparse
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from zbench import config, gen  # noqa: E402


def out_file(cfg, name):
    d = os.path.join(cfg['work'], 'out')
    os.makedirs(d, exist_ok=True)
    return os.path.join(d, f"{name}-{time.strftime('%Y%m%d-%H%M%S')}.json")


def cmd_perf(cfg, a):
    from zbench import perf, sandbox
    extra = set(a.targets.split(',')) if a.targets else set()
    perf.run(cfg, a.refs, a.base, sandbox.expand(a.rows), a.rounds, a.nvim.split(','), extra, a.seed, a.strict,
             out_file(cfg, 'perf'))


def cmd_diff(cfg, a):
    from zbench import diff
    clean = diff.run(cfg, a.base, a.refs, a.seeds, a.oracle, a.nvim)
    sys.exit(0 if clean else 1)


def cmd_probe(cfg, a):
    from zbench import probe
    clean = probe.run(cfg, a.refs, a.config or cfg['user_config'], a.reps, a.rounds, a.nvim)
    sys.exit(0 if clean else 1)


def cmd_fetch(cfg, a):
    from zbench import diff
    diff.fetch_lazyvim(cfg, a.sha)


def cmd_gen(cfg, a):
    for n in a.n.split(','):
        print(gen.set_dir(cfg, int(n), a.seed))


def main():
    p = argparse.ArgumentParser(prog='zb', description=__doc__)
    sub = p.add_subparsers(dest='cmd', required=True)

    s = sub.add_parser('perf', help='cross-process startup: shuffled paired rounds, d-cpu with 95%% CI')
    s.add_argument('refs', nargs='+', help='zpack refs; the first is the one every delta is taken from')
    s.add_argument('--base', help='zpack ref to compare against (adds a target)')
    s.add_argument('--rows', default='default', help='comma list of <scenario><n>[@vimenter|@plugin], or default|matrix|all')
    s.add_argument('--rounds', type=int, default=100)
    s.add_argument('--nvim', default='nightly', help='comma list of names from config.json nvim, e.g. nightly,0.12')
    s.add_argument('--targets', default='aa,lazy', help='extra targets: aa (A/A copy of the first ref), lazy, bare, native')
    s.add_argument('--seed', type=int, default=24, help='round-order and bootstrap seed')
    s.add_argument('--strict', action='store_true', help='exit 1 if any row ran above max_load or had errors')
    s.set_defaults(fn=cmd_perf)

    s = sub.add_parser('diff', help='functional differential: lazy= flips, structure, opts on LazyVim + live config')
    s.add_argument('base')
    s.add_argument('refs', nargs='+')
    s.add_argument('--seeds', type=int, default=40, help='LazyVim subsets (each extra kept with p=0.3)')
    s.add_argument('--oracle', action='store_true', help='also diff the last ref against lazy.nvim on the subsets')
    s.add_argument('--nvim', default='nightly')
    s.set_defaults(fn=cmd_diff)

    s = sub.add_parser('probe', help='real-config startup with XDG isolated: dump and diff state per tree')
    s.add_argument('refs', nargs='+', help='zpack refs; the first is the baseline')
    s.add_argument('--config', help='nvim config dir (default: user_config); data is a clone of user_data')
    s.add_argument('--reps', type=int, default=5)
    s.add_argument('--rounds', type=int, default=0, help='also time startup with a file arg, paired and shuffled')
    s.add_argument('--nvim', default='nightly')
    s.set_defaults(fn=cmd_probe)

    s = sub.add_parser('fetch-lazyvim', help="download LazyVim's source as data (parsed, never executed)")
    s.add_argument('sha', nargs='?', help='default: current main')
    s.set_defaults(fn=cmd_fetch)

    s = sub.add_parser('gen', help='generate synthetic plugin sets (normally implicit)')
    s.add_argument('--n', default='150,300')
    s.add_argument('--seed', type=int, default=1)
    s.set_defaults(fn=cmd_gen)

    a = p.parse_args()
    a.fn(config.load(), a)


if __name__ == '__main__':
    main()
